# NAVER Review Cloud Export POC — environment NAMES ONLY.
# Copy to .env and fill locally. .env is gitignored. Never commit values.
#
# Every one of these is REQUIRED and there is no default. The POC fails closed on a
# missing name rather than guessing, because each of them is a decision:
#   which third party holds the seller's session, which vendor sees the seller's pages,
#   and whether screenshots of customer review text leave this machine.

# --- Steel (cloud browser that will hold the NAVER seller-center session) ---
STEEL_API_KEY=

# Steel region the browser runs in. Steel has no Korean region; nrt (Tokyo) is the
# closest to a Korean seller center. The region is part of the login's fingerprint:
# log in and re-run from the SAME region or NAVER may ask to re-verify.
POC_STEEL_REGION=nrt

# --- LLM that drives the browser (browser-use) ---
# openai | anthropic
POC_LLM_PROVIDER=
POC_LLM_API_KEY=
# No default. We do not guess a model id.
POC_LLM_MODEL=

# true | false  — MUST be set explicitly.
# true  = page SCREENSHOTS of the seller center (customer names, review text) are sent
#         to the LLM vendor on every step. More reliable, widest payload.
# false = serialized DOM text only. Still sends page text, but no images.
# There is no safe default here; that is why there is no default.
POC_USE_VISION=

# --- Privacy ---
# Any long random local string. Salts the one-way digest of the observed store identifier
# so the run log records "the same store as last run" without recording which store.
POC_DIGEST_SALT=

# --- Run bounds ---
# Set after `run.py login` prints it. Empty = first run creates a new profile.
POC_PROFILE_ID=
# Hard ceiling on agent steps. The run fails rather than wandering.
POC_MAX_STEPS=40

# --- Live approval (set only for the turn the operator approved) ---
# The approval id that `python -m poc.run manifest` printed. Without it every live leg refuses.
POC_LIVE_APPROVAL=
