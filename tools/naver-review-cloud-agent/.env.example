# Cloud NAVER review export agent — environment NAMES ONLY.
# Copy to .env on the agent host (mode 0600). Never commit the copy.
#
# Every name below is REQUIRED and has no default except where stated. A missing name stops the agent
# rather than letting it guess: each one is a decision about what leaves this machine.

# ── Reviewnary ───────────────────────────────────────────────────────────────
# The pilot site. https, same host the seller's browser uses.
REVIEWNARY_BASE_URL=

# The helper device token minted for THIS agent (rvh_…). Obtained once:
#   POST /api/auth/device/code   -> userCode
#   operator approves it in their own browser: POST /api/helper-devices/approve {userCode}
#   POST /api/auth/device/token  -> rvh_…
# The token is scoped by HelperDeviceAuthFilter's allow-list; it cannot reach a seller surface.
REVIEWNARY_DEVICE_TOKEN=

# ── LLM that drives the browser ──────────────────────────────────────────────
# openai | anthropic
AGENT_LLM_PROVIDER=
AGENT_LLM_API_KEY=
# No default. A model id the vendor refuses stops the run — there is no fallback.
AGENT_LLM_MODEL=

# MUST be exactly `false`. `true` is refused at config load: this lane is text / accessibility
# serialization only, and the `screenshot` action is removed from the catalogue as well.
AGENT_USE_VISION=false

# ── Run bounds ───────────────────────────────────────────────────────────────
# Hard ceiling on agent steps per cycle. The cycle fails rather than wandering.
AGENT_MAX_STEPS=40
# Minutes between cycles in `shadow`. The seller centre's export is a per-month bound, so a short
# interval buys nothing; 120 matches the responsibility runtime's own 2-hour window.
AGENT_INTERVAL_MINUTES=120
# false keeps one consistent browser fingerprint across the sign-in leg and every later cycle.
# The sign-in leg REFUSES to run headless — you have to see the screen to sign in.
AGENT_HEADLESS=false

# ── Privacy ──────────────────────────────────────────────────────────────────
# Any long random local string, generated on this host. Salts the one-way digest of the observed store
# identifier, so a run log can say "the same store as last cycle" without saying which store.
AGENT_DIGEST_SALT=
